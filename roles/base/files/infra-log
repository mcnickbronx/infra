#!/usr/bin/env bash
# Управляется Ansible (роль base).
# Журнал событий сервера — что, когда и кто: изменения настроек, пароли, обновления, бэкапы,
# восстановления, выкладки. По строке на событие в /var/log/infra.log (хранится два года,
# входит в ночной бэкап) и копия в journal: journalctl -t infra.
#   infra-log "apply: готово, изменений 3"      — событие
#   diff ... | infra-log -                      — подробности под событием, с отступом
# Кто — INFRA_WHO (его задаёт команда infra: пользователь и IP), иначе пользователь sudo,
# иначе «система» (таймер: ночной бэкап, автовыкладка).
# Запись — попутная: не вышло (диск заполнен) — предупреждение, но код выхода 0. Иначе сбой
# журнала ронял бы то, что его вызвало: восстановление, выкладку, бэкап (у них set -e)
set -uo pipefail
umask 027
LOG=/var/log/infra.log
[ -e "$LOG" ] || install -m 0640 -g adm /dev/null "$LOG" 2>/dev/null     # как его создаёт роль base

if [ "${1:-}" = - ]; then
  sed 's/^/    /' >>"$LOG" || { echo "infra-log: не записано в $LOG" >&2; cat >/dev/null; }
  exit 0
fi
who=${INFRA_WHO:-${SUDO_USER:-система}}
logger -t infra -- "$who $*" 2>/dev/null
printf '%s %s %s\n' "$(date '+%F %T')" "$who" "$*" >>"$LOG" || echo "infra-log: не записано в $LOG: $*" >&2
exit 0

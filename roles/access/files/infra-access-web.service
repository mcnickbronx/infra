[Unit]
Description=Access link page: open SSH for the visitor's IP (infra access_link)
After=network.target

[Service]
ExecStart=/usr/local/bin/infra-access-web
# Без прав: секрета не знает (только sha256), правила ufw ставит root — infra-access.path
DynamicUser=yes
RuntimeDirectory=infra-access/queue infra-access/done
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Страницу видно из интернета: взломай её кто-то — дальше 127.0.0.1 и обычных системных вызовов
# он не уйдёт
IPAddressAllow=localhost
IPAddressDeny=any
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0077
TasksMax=128
MemoryMax=64M
Restart=on-failure

[Install]
WantedBy=multi-user.target

#!/usr/bin/env python3
# Управляется Ansible (роль access). Страница ссылки доступа: https://<адрес>/access/<секрет>.
#   GET  — «Ваш IP …, открыть SSH на N часов?» с кнопкой. Только показывает: мессенджеры сами
#          открывают ссылки ради предпросмотра, и доступ им открываться не должен;
#   POST — кнопка: заявка в очередь /run/infra-access/queue. Правило в ufw добавляет root
#          (infra-access process, его запускает infra-access.path), ответ — в /run/infra-access/done.
# Работает без прав (DynamicUser) и секрета не знает — только его sha256 (/etc/infra-access/config.json).
# Слушает 127.0.0.1: снаружи — только через Traefik, он и сообщает IP посетителя (X-Real-Ip).
# В журнал адреса запросов не пишутся: в них секрет. Логика — в функциях, их проверяет tests/test_scripts.py.
import hashlib
import hmac
import html
import ipaddress
import json
import os
import secrets
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = "/etc/infra-access/config.json"
QUEUE = "/run/infra-access/queue"
DONE = "/run/infra-access/done"
PREFIX = "/access/"
WAIT = 15            # секунд ждать ответа root: дольше — «заявка принята», правило всё равно появится


def token_ok(path, token_sha256):
    """Путь /access/<секрет> с верным секретом. Сравнение по времени не зависит от совпадения."""
    if not path.startswith(PREFIX):
        return False
    token = path[len(PREFIX):].split("?", 1)[0].rstrip("/")
    if not token or len(token) > 128:
        return False
    return hmac.compare_digest(hashlib.sha256(token.encode()).hexdigest(), token_sha256)


def public_ip(value):
    """IP посетителя из заголовка Traefik — только публичный: свою сеть открывать незачем."""
    try:
        ip = ipaddress.ip_address((value or "").strip())
    except ValueError:
        return None
    return str(ip) if ip.is_global else None


def page(title, body):
    return f"""<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex"><title>{html.escape(title)}</title>
<style>body{{font:18px/1.5 system-ui,sans-serif;max-width:32em;margin:3em auto;padding:0 1em;color:#222}}
button{{font:inherit;padding:.6em 1.4em;border:0;border-radius:.4em;background:#1a6be0;color:#fff}}
code{{background:#f1f1f1;padding:0 .3em}}</style></head>
<body><h1>{html.escape(title)}</h1>{body}</body></html>"""


def form(server, ip, hours):
    return page(f"Доступ к {server}", f"""<p>Ваш IP: <code>{html.escape(ip)}</code></p>
<p>Открыть ему SSH на {hours} ч? Войти можно будет только своим SSH-ключом, как обычно.</p>
<form method="post"><button>Открыть SSH</button></form>""")


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass                                     # в пути — секрет; что открыто, пишет root

    def send_response(self, code, message=None):
        # Без заголовка Server: код движка открыт, и по нему страница выдавала бы, что за сервер
        self.send_response_only(code, message)
        self.send_header("Date", self.date_time_string())

    def not_found(self):
        """Неверный секрет — тот же ответ, что у Traefik на неизвестный адрес: без примет этой страницы."""
        data = b"404 page not found\n"
        self.send_response(404)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_error(self, code, message=None, explain=None):
        self.not_found()                         # другие методы, кривой запрос — без страницы ошибки Python

    def reply(self, code, text):
        data = text.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(data)

    def checked(self):
        """Настройки и IP посетителя — или ответ с ошибкой (тогда None)."""
        with open(CONF) as f:
            conf = json.load(f)
        if not token_ok(self.path, conf["token_sha256"]):
            self.not_found()
            return None
        ip = public_ip(self.headers.get("X-Real-Ip"))
        if not ip:
            self.reply(400, page("Не вышло", "<p>Не удалось узнать ваш внешний IP.</p>"))
            return None
        return conf, ip

    def do_GET(self):
        got = self.checked()
        if got:
            conf, ip = got
            self.reply(200, form(conf["server"], ip, conf["hours"]))

    def do_POST(self):
        got = self.checked()
        if not got:
            return
        conf, ip = got
        rid = secrets.token_hex(8)
        # Сначала под именем с точкой (root такие пропускает), затем переименовать: заявка появляется
        # в очереди целиком. В той же папке: queue и done — разные точки монтирования (systemd)
        tmp = os.path.join(QUEUE, "." + rid)
        with open(tmp, "w") as f:
            f.write(ip + "\n")
        os.replace(tmp, os.path.join(QUEUE, rid))
        answer = os.path.join(DONE, rid)
        for _ in range(WAIT * 4):
            if os.path.exists(answer):
                with open(answer) as f:
                    text = f.read().strip()
                os.remove(answer)
                self.reply(200, page(conf["server"], f"<p>{html.escape(text)}</p>"))
                return
            time.sleep(0.25)
        self.reply(200, page(conf["server"], "<p>Заявка принята, через минуту SSH будет открыт.</p>"))


if __name__ == "__main__":
    with open(CONF) as f:
        port = json.load(f)["port"]
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()

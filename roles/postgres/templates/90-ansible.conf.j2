# Управляется Ansible. Рассчитано на {{ ansible_memtotal_mb }} МБ RAM,
# под Postgres отведено {{ ((postgres_memory_share | float) * 100) | int }}%.
listen_addresses = '*'          # доступ ограничивают pg_hba.conf и файрвол
max_connections = 200
shared_buffers = {{ (ansible_memtotal_mb * (postgres_memory_share | float) * 0.25) | int }}MB
effective_cache_size = {{ (ansible_memtotal_mb * (postgres_memory_share | float) * 0.75) | int }}MB
maintenance_work_mem = 256MB
work_mem = 16MB
wal_compression = on
random_page_cost = 1.1          # для SSD/NVMe
effective_io_concurrency = 200  # SSD/NVMe и сетевые диски VDS: страницы читаются параллельно
jit = off                       # коротким запросам сайта JIT добавляет задержку, а не ускоряет
password_encryption = scram-sha-256

# Сессия, которая простаивает внутри незакрытой транзакции (зависший воркер, забытый
# BEGIN в консоли), держит блокировки и не даёт очистке таблиц убирать старые строки
idle_in_transaction_session_timeout = 10min

# Что оптимизировать — по данным, а не наугад (README, «Медленные запросы Postgres»):
# статистика всех запросов — представление pg_stat_statements в базе postgres
shared_preload_libraries = 'pg_stat_statements'
# в лог: запросы дольше секунды, ожидание блокировок, сортировки, которым не хватило work_mem
log_min_duration_statement = 1s
log_lock_waits = on
log_temp_files = 0

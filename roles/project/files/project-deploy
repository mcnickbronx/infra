#!/usr/bin/env bash
# Управляется Ansible (роль project).
# Автовыкладка проекта из реестра образов (autodeploy: true у проекта в server.yml):
#   project-deploy <проект>            — выложить, если в реестре новый образ (так каждые 15 секунд
#                                        зовёт таймер project-deploy@<проект>.timer)
#   project-deploy <проект> image      — вывести проверенный DEPLOY_IMAGE (нет образа — пусто), без выкладки
#   project-deploy <проект> rollback   — вернуть версию, которая стояла до последней выкладки
#   project-deploy <проект> to <тег>   — выложить тот же образ с другим тегом (у сайтов web-start —
#                                        версия v3.0.0 или полный хеш коммита) и записать его
#                                        в DEPLOY_IMAGE в .env
#   project-deploy <проект> to <тег> --wait — то же, но сначала ждать, пока CI соберёт образ с этим тегом
#                                        (до 15 минут, раз в 20 с; не дождался — ничего не менял): сразу после push
#
# Договорённость с проектом (TEAM.md, «Автовыкладка»):
#   - в .env проекта DEPLOY_IMAGE=ghcr.io/<владелец>/<образ>:<ветка> — его собирает CI;
#   - в образе /deploy/compose.yml — compose проекта, в нём image: ${DEPLOY_IMAGE};
#   - сервис deploy (профиль deploy) готовит выкладку: миграции, статика. Нет его — шаг пропускается.
# compose.yml из образа запускается от root без проверки: кто пушит в ветку, тот root
# на сервере (DECISIONS.md, «Автовыкладка»).
#
# Версия — дайджест образа в реестре (repo@sha256:...): по нему образ можно скачать снова,
# даже если его уже удалила еженедельная очистка Docker. Сбой на любом шаге — возвращаются
# прежний образ и прежний compose.yml (при первой выкладке — те, что запускали руками),
# а эта версия больше не пробуется (ждём следующую). Об ошибке сообщает health-check, о выложенной
# новой версии — строка в Telegram с версией образа или его коммитом (таймер и ручной project-deploy <проект>;
# не дольше 15 с).
#
# Состояние — файлы /var/lib/project-deploy/<проект>.*:
#   current      версия, которая работает
#   previous     версия до неё — для rollback
#   failed-ref   версия, которая не удалась или откачена: таймер её больше не выкладывает
#   failed       когда и на каком шаге не удалось, что работает теперь — по нему health-check
#                шлёт уведомление
#   lock         одна выкладка проекта за раз
#   image        репозиторий, из которого можно скачивать образ (image у проекта в server.yml; пишет роль project)
#
# Порядок в файле: состояние, шаги выкладки, deploy, rollback и to, запуск — в самом конце.
set -Eeuo pipefail

NAME=${1:?Использование: project-deploy <проект> [image | rollback | to <тег> [--wait]]}
ACTION=${2:-deploy}
TAG=${3:-}
WAIT=${4:-}
TO=                                                     # образ у to (tag_ref); не из окружения — версия в уведомлении
[[ $NAME =~ ^[a-z][a-z0-9_]*$ ]] || { echo "Недопустимое имя проекта: $NAME" >&2; exit 1; }
[[ $ACTION =~ ^(deploy|rollback|to|image)$ ]] ||
  { echo "Неизвестное действие «${ACTION}»: project-deploy <проект> [image | rollback | to <тег> [--wait]]" >&2; exit 1; }
# После действия — только тег у to и за ним --wait. Лишнее — отказ, а не тихий пропуск: с опечаткой (--wiat)
# или с --wait не у to выкладка пошла бы сразу, без ожидания
if [ "$ACTION" = to ]; then extra=${*:4}; [ "$extra" != --wait ] || extra=; else extra=${*:3}; fi
[ -z "$extra" ] || { echo "Лишнее «${extra}»: project-deploy <проект> [image | rollback | to <тег> [--wait]]" >&2; exit 1; }
# Тег — по правилам Docker: так он не выходит за строку DEPLOY_IMAGE в .env
[ "$ACTION" != to ] || [[ $TAG =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] ||
  { echo "Тег образа — латиница, цифры, _ . - (до 128 знаков, первый — не . и не -): project-deploy $NAME to <тег>" >&2; exit 1; }
PROJ=/srv/projects/$NAME
WEB=$PROJ/web
STATE=/var/lib/project-deploy/$NAME

# ---------- Состояние ----------
state() { cat "$STATE.$1" 2>/dev/null || true; }       # state current — версия или пусто
set_state() { echo "$2" > "$STATE.$1"; }               # set_state current <версия>

# image у проекта: образ $1 — только из этого репозитория, иначе root скачал бы своим входом в ghcr чужой приватный
# образ, вписанный участником в .env. Репозиторий — без @дайджеста и без :тега (тег — после последнего /, как в to),
# и равен строке целиком: shop-evil и shop/x — не shop. image не задан — любой. Отказ — с текстом: $2 — что проверяли
own_image() {
  local allowed repo=${1%%@*}
  allowed=$(state image)
  [ -n "$allowed" ] || return 0
  [[ ${repo##*/} != *:* ]] || repo=${repo%:*}
  [ "$repo" = "$allowed" ] ||
    { echo "$NAME: $2 — образ не этого проекта (image в server.yml: $allowed); не скачиваю" >&2; return 1; }
}

# IMAGE — DEPLOY_IMAGE из .env (папка — web/ проекта). web/ пишут участники: .env — один раз и без перехода по ссылке
# (dd с nofollow: ссылка на месте .env — отказ, проверки «до» и гонки нет, как в to); nonblock — FIFO на месте .env
# не вешает таймер. По умолчанию нет образа — прежний отказ выкладки; read_image optional разрешает
# отсутствие .env или строки для rootless. Ошибка чтения существующего файла и FIFO — отказ и у optional.
read_image() {
  local failed=
  IMAGE=$(dd if=.env iflag=nofollow,nonblock status=none 2>/dev/null | sed -n 's/^DEPLOY_IMAGE=//p' | tail -1 | tr -d "\"'") || { IMAGE=; failed=1; }
  [ -n "$IMAGE" ] || [ ! -L .env ] ||                     # -L — только для текста: защищает nofollow
    { echo "$NAME: web/.env — ссылка: root по ссылке не читает, выкладка не идёт; замените ссылку файлом" >&2; exit 1; }
  if [ "${1:-}" = optional ]; then
    { [ -z "$failed" ] || [ ! -e .env ]; } && [ ! -p .env ] ||
      { echo "$NAME: web/.env не читается или не обычный файл — образ не получен" >&2; return 1; }
    return 0
  fi
  [ -n "$IMAGE" ] || { echo "$NAME: нет DEPLOY_IMAGE в .env — автовыкладка не настроена" >&2; exit 1; }
}

# Версия для журнала событий: образ и начало дайджеста (repo@sha256:0123456789ab)
short() { sed -E 's/(sha256:[0-9a-f]{12})[0-9a-f]*/\1/' <<<"${1:-—}"; }

# Коммит, из которого собран образ $1, — ярлык org.opencontainers.image.revision (его ставит CI web-start):
# его, в отличие от дайджеста, можно дать to <тег>. Нет ярлыка или не похож на хеш — пусто
revision() {
  local rev
  rev=$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$1" 2>/dev/null) || rev=
  [[ $rev =~ ^[0-9a-f]{7,64}$ ]] && echo "$rev" || true
}

# Версия, из которой собран образ $1, — ярлык org.opencontainers.image.version (его ставит CI web-start, git describe
# --tags): на теге — v3.0.0, между выпусками — v2.4.0-64-gfe590f6 (64 коммита после v2.4.0). Нет ярлыка — тег
# образа $2, если он — версия (to v3.0.0). Ярлык и тег задаёт участник проекта, поэтому только по образцу — иначе
# в уведомление и журнал событий попал бы любой его текст. Не по образцу — пусто
release() {
  local ver re='^v[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}(-[0-9]{1,9}-g[0-9a-f]{7,40})?$'
  ver=$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$1" 2>/dev/null) || ver=
  if ! [[ $ver =~ $re ]]; then
    ver=${2##*/} ver=${ver%%@*}                           # тег — после последнего / и до @дайджеста
    [[ $ver == *:* ]] && ver=${ver##*:} || ver=
  fi
  [[ $ver =~ $re ]] && echo "$ver" || true
}

# Имя сервера для уведомления — как у команды infra (server_name в server.yml); нет его — имя хоста
server_name() {
  local name
  name=$(sed -nE "s/^server_name:[[:space:]]*[\"']?([a-z0-9-]+).*/\1/p" /etc/infra/server.yml 2>/dev/null | head -1) || true
  echo "${name:-$(hostname)}"
}

# Только чтение для rootless — до Docker, ожидания и состояния выкладки.
if [ "$ACTION" = image ]; then
  cd "$WEB"
  read_image optional
  if [ -n "$IMAGE" ]; then
    own_image "$IMAGE" "DEPLOY_IMAGE=$IMAGE" || exit 1
    printf '%s\n' "$IMAGE"
  fi
  exit 0
fi

# ---------- Шаги выкладки ----------
compose() { project-compose "$NAME" "$@"; }
# Проект без root (rootless): образы и контейнеры — в его Docker. Скачивает образ root (вход в ghcr —
# у root), а compose.yml из образа запускает пользователь проекта (project-compose)
DOCKER_HOST=$(project-docker-host "$NAME")
[ -n "$DOCKER_HOST" ] && export DOCKER_HOST || unset DOCKER_HOST

# Версия образа: первый дайджест реестра (repo@sha256:...); у образа без реестра — пусто
version_of() { docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$1" 2>/dev/null | head -1; }

# Образ (Id), на котором работают сервисы проекта с образом из .env, — до первой автовыкладки
# проект запускали руками. Не запущен — пусто
running_image() {
  docker ps -q --filter "label=com.docker.compose.project=$NAME" |
    xargs -r docker inspect -f '{{.Config.Image}} {{.Image}}' |
    awk -v img="$IMAGE" '$1 == img { id = $2 } END { print id }' || true
}

# Папку проекта пишет только root (роль project: root, 0750)? Временные файлы root кладёт туда, а не в web/,
# где их подменили бы ссылкой. Нет — текст ($1 — что не кладу) и код 1
proj_root_only() {
  [ "$(stat -c %u -- "$PROJ")" = "$(id -u)" ] && (( (8#$(stat -c %a -- "$PROJ") & 8#022) == 0 )) ||
    { echo "$NAME: в папку $PROJ пишет не только root — $1; права вернёт sudo infra apply" >&2; return 1; }
}

# Проект — на версию $1: образ — под именем из .env, его compose.yml — в web/
# (прежний — в compose.yml.prev, его возвращает restore). web/ открыта участникам на запись: файлы
# там root не открывает на запись по имени — подложенная ссылка направила бы запись в чужой файл.
# Прежний — жёсткой ссылкой (ln -P не идёт по ссылке-источнику; -T — и по ссылке на месте нового имени: без -T
# ссылка на папку значила бы «положить внутрь неё»), новый — во временный файл в папке проекта (её пишет
# только root — proj_root_only) и на место одним mv, как .env у to: та же файловая система — mv переименовывает,
# а ссылку на месте compose.yml заменяет, не идя по ней. noclobber (set -C) тут не защита: bash отказывает,
# только если цель — обычный файл, а по ссылке на устройство или FIFO пишет. Группа и права — как у файла,
# созданного в web/ (setgid): группа проекта, 660 — его читают участники и пользователь проекта без root
# (project-compose: <проект>-run — в группе проекта); ACL папки не переносятся — контейнерам файл не нужен.
# Остановили между mktemp и mv — временный файл убирает trap, как у .env в to; compose.yml.new — остаток версий
# до v2.1.0 (rm ссылку удаляет, не идя по ней) — после proj_root_only: rm берёт имя там, куда ведёт web, а в открытой
# папке проекта web может быть ссылкой на чужую web/
switch_to() {
  rm -f compose.yml.prev
  [ ! -f compose.yml ] || ln -PT compose.yml compose.yml.prev 2>/dev/null || true
  proj_root_only "временный compose.yml туда не кладу" && rm -f compose.yml.new && docker pull -q "$1" >/dev/null &&
    docker tag "$1" "$IMAGE" && COMPOSE_NEW=$(mktemp "$PROJ/compose.yml.XXXXXX") || return 1
  trap 'rm -f "$COMPOSE_NEW"' EXIT
  docker run --rm --entrypoint cat "$IMAGE" /deploy/compose.yml > "$COMPOSE_NEW" &&
    chown "$(stat -c %u:%g -- "$WEB")" "$COMPOSE_NEW" && chmod 660 "$COMPOSE_NEW" && mv -fT "$COMPOSE_NEW" compose.yml ||
    { rm -f "$COMPOSE_NEW"; return 1; }
}

# Вернуть, как было до switch_to: прежний compose.yml и образ $1 (версия или Id) — и запустить.
# Код ошибки — если возвращать нечего ($1 пуст) или проект не поднялся. mv — с -T: ссылку участника на папку
# на месте compose.yml он заменяет, а не кладёт compose.yml.prev внутрь той папки
restore() {
  [ ! -f compose.yml.prev ] || mv -fT compose.yml.prev compose.yml
  [ -n "$1" ] && docker tag "$1" "$IMAGE" && up
}

# Папки проекта, которые монтирует compose: нет — создать с записью для группы, как web/
# (иначе их создаст Docker от root, и приложение не сможет туда писать).
# web/ пишут участники: часть пути тома может быть ссылкой (web/a → чужая папка, том ./a/b) —
# install -d/mkdir -p прошли бы по ней и создали папку в ЧУЖОЙ папке от root. Поэтому путь тома
# создаём по одной части от $WEB вниз (make_dir_nofollow): любая часть — ссылка → отказ и выход 1
# (выкладка не идёт, сообщение называет путь), а не переход по ней. Уже созданную папку не трогаем.
# Сервисы — и запущенные, и deploy: --profile в команде заменяет профили из .env, поэтому два прохода
make_dirs() {
  { compose config --format json; compose --profile deploy config --format json; } |
    jq -r '.services[].volumes[]? | select(.type == "bind") | .source' |
    sort -u | while read -r d; do
      case $d in "$WEB"/*) make_dir_nofollow "$d" || exit 1 ;; esac
    done
}

# Создать папку тома $1 (она под $WEB), не идя по ссылке в web/. Уже есть — ничего не делаем, как
# прежде (`[ -e ] || install -d`): root там ничего не создаёт и режим не меняет. Нет — спускаемся от
# $WEB по одной части: недостающую — отдельным mkdir, потом cd -P в неё и сверка, что настоящий путь —
# ровно ожидаемый: часть — ссылка (и подменённая между mkdir и cd) или не папка → отказ. Режим ставим
# на папку, в которой стоим (chmod ., а не по имени — подменить её ссылкой уже нельзя), у каждой
# созданной части, как у web/. 02770 — с нулём впереди: в Ubuntu 26.04 mkdir uutils 0.8 давал 7775,
# а chmod 2770 setuid у папки не снимает (v1.7.2). Подоболочка — cd не уходит из функции
make_dir_nofollow() (
  d=$1 rel=${1#"$WEB"/}
  [ ! -d "$d" ] || exit 0
  cd -P "$WEB" || exit 1
  while [ -n "$rel" ]; do
    part=${rel%%/*}
    case $rel in */*) rel=${rel#*/} ;; *) rel= ;; esac   # rel опустел → part был последней частью
    case $part in
      '' | .) continue ;;
      ..) echo "$NAME: путь тома «${d}» содержит .. — папку не создаю" >&2; exit 1 ;;
    esac
    here=$(pwd -P) new=
    [ -e "$part" ] || [ -L "$part" ] || { mkdir -- "$part" || exit 1; new=1; }
    if [ -L "$part" ] || ! cd -P -- "$part" 2>/dev/null || [ "$(pwd -P)" != "${here%/}/$part" ]; then
      echo "$NAME: путь тома $d идёт через ссылку или не папку ($here/$part) — папку не создаю (web/ пишут участники; замените ссылку папкой)" >&2
      exit 1
    fi
    [ -z "$new" ] || chmod 02770 . || exit 1
  done
)

up() { compose up -d --wait --wait-timeout 180 --remove-orphans; }

# ---------- Выкладка новой версии ----------
# OLD — версия, которая работает, NEW — версия из реестра, BACK — что вернуть при сбое: OLD,
# а при первой выкладке — образ, на котором проект запускали руками (общие для deploy, to и fail)
deploy() {
  OLD=$(state current)
  BACK=${OLD:-$(running_image)}
  docker pull -q "$IMAGE" >/dev/null
  NEW=$(version_of "$IMAGE")
  [ -n "$NEW" ] || { echo "$NAME: у образа $IMAGE нет дайджеста реестра" >&2; exit 1; }
  [ "$NEW" != "$OLD" ] || exit 0                         # нового нет — так почти при каждой проверке
  if [ "$NEW" = "$(state failed-ref)" ]; then            # эта версия уже не удалась — ждём следующую;
    [ -z "$BACK" ] || docker tag "$BACK" "$IMAGE"        # docker pull перевесил имя из .env на неё — вернуть
    exit 0
  fi
  roll_out
}

# Выложить NEW под именем из .env; сбой на шаге — fail
roll_out() {
  echo "$NAME: новая версия $NEW"
  switch_to "$NEW" || fail "compose.yml из образа"
  make_dirs || fail "папки проекта"
  # Список сервисов — целиком в переменную: grep -q закрыл бы конвейер на первом совпадении,
  # compose получил бы SIGPIPE, и с pipefail подготовка молча пропускалась бы
  services=$(compose --profile deploy config --services) || fail "чтение compose.yml"
  if grep -qx deploy <<<"$services"; then
    compose run --rm deploy || fail "подготовка (сервис deploy)"
  fi
  up || fail "запуск"

  [ -z "$OLD" ] || set_state previous "$OLD"
  set_state current "$NEW"
  rm -f "$STATE.failed" "$STATE.failed-ref" compose.yml.prev
  echo "$NAME: выложено"
  rev=$(revision "$NEW")
  ver=$(release "$NEW" "${TO:-$IMAGE}")                 # TO — образ у to, у таймера его нет
  infra-log "выкладка $NAME: готово, $(short "$NEW")${ver:+, версия $ver}${rev:+, коммит $rev}"
  # Выложена новая версия (таймер или ручной project-deploy <проект>) — строка в Telegram: push дошёл до сайта
  # (to и откат человек видит в выводе). Что выложено: «v3.0.0, коммит 5d77a89»; между выпусками — «v2.4.0 +64,
  # коммит fe590f6»; версии нет — «новая версия, коммит 1a2b3c4». Коммит — и рядом с версией: ярлык version образ
  # наследует от базового (у caddy:2-alpine — v2.11.7), если проект не ставит свой, — коммит ложная версия не спрячет.
  # Нет ярлыка revision — коммит из хеша в версии
  if [[ $ver =~ ^(v[0-9.]+)-([0-9]+)-g([0-9a-f]+)$ ]]; then
    what="${BASH_REMATCH[1]} +${BASH_REMATCH[2]}" rev=${rev:-${BASH_REMATCH[3]}}
  else
    what=${ver:-новая версия}
  fi
  what+=${rev:+, коммит ${rev:0:7}}
  # timeout 15: при закрытом Telegram infra-notify ждёт минуту и дольше, а замок проекта ещё наш — rollback и to ждут
  # его 30 с (ниже); 9>&- — отправке замок не нужен. Не ушло — не повторяем: выкладка — в журнале событий
  [ "$ACTION" != deploy ] ||
    timeout 15 infra-notify "🚀 $(server_name): $NAME — выложена $what" >/dev/null 2>&1 9>&- || true
}

# Шаг $1 не удался: эту версию больше не пробовать, вернуть прежние образ и compose.yml.
# Отметки — до возврата: оборвись он, таймер всё равно не возьмёт эту версию снова
fail() {
  local when result
  when=$(date '+%F %H:%M')
  # Ручной to — с пометкой: health-check не отсылает к журналу таймера и не обещает, что версия выложится сама
  [ "$ACTION" != to ] || when+=" вручную (to $TAG),"
  echo "$NAME: не удалось на шаге «$1» — возвращаю прежнюю версию" >&2
  # Отметка — одна версия, и сбой to (решение администратора) стоящую не затирает: это версия из ветки в .env,
  # которая не удалась или откачена, — без отметки таймер выложил бы её снова через 15 секунд
  [ "$ACTION" = to ] && [ -n "$(state failed-ref)" ] || set_state failed-ref "$NEW"
  set_state failed "$when $1"
  if restore "$BACK"; then
    result="работает прежняя версия"
  elif [ -z "$BACK" ]; then
    result="прежней версии нет"
  else
    result="и прежняя версия не поднялась — нужен администратор"
  fi
  set_state failed "$when $1: $result"
  echo "$NAME: $result" >&2
  infra-log "выкладка $NAME: $(short "$NEW") не удалась на шаге «$1» — $result"
  exit 1
}

# ---------- Откат вручную ----------
# Откат — решение администратора, не сбой: health-check о нём не сообщает
rollback() {
  local prev cur
  prev=$(state previous)
  [ -n "$prev" ] || { echo "$NAME: прежней версии нет — откатывать нечего" >&2; exit 1; }
  own_image "$prev" "прежняя версия $prev" || exit 1     # выложенную до image чужую откат не вернёт
  cur=$(state current)
  echo "$NAME: возвращаю $prev"
  if ! { switch_to "$prev" && make_dirs && up; }; then
    if restore "$cur"; then
      echo "$NAME: откат не удался — работает версия, которая была" >&2
      infra-log "откат $NAME на $(short "$prev"): не удался, работает прежняя версия"
    else
      echo "$NAME: откат не удался, и версия, которая была, не поднялась — нужен администратор" >&2
      infra-log "откат $NAME на $(short "$prev"): не удался, и прежняя версия не поднялась"
    fi
    exit 1
  fi
  set_state current "$prev"
  set_state failed-ref "$cur"                            # таймер не выложит её снова — только следующую
  rm -f "$STATE.previous" "$STATE.failed" compose.yml.prev
  echo "$NAME: откат выполнен"
  infra-log "откат $NAME: готово, работает $(short "$prev")"
}

# ---------- Другая версия вручную ----------
# Проверки to, которым реестр не нужен (отказ — ничего не менял), и TO — тот же образ, что в DEPLOY_IMAGE, с тегом TAG
tag_ref() {
  local repo=$IMAGE
  # -L — только для текста: защищает nofollow
  [ ! -L .env ] || { echo "$NAME: .env — ссылка, а не файл: root по ссылке не пишет" >&2; exit 1; }
  # Временный .env — в папке проекта (to, ниже): её права — до выкладки, чтобы отказ ничего не менял
  proj_root_only "временный .env туда не кладу, ничего не менял" || exit 1
  # Строки DEPLOY_IMAGE — из чтения, как у read_image: .env, подменённый после проверки ссылкой или FIFO, root не читает
  # и не ждёт — 0 строк. Одно чтение на три исхода — case: n=$(…) при 0 строк под set -e оборвал бы скрипт без текста
  case $(dd if=.env iflag=nofollow,nonblock status=none 2>/dev/null | grep -c '^DEPLOY_IMAGE=') in
    1) ;;
    0) echo "$NAME: web/.env не прочитан без перехода по ссылке или в нём нет строки DEPLOY_IMAGE — ничего не менял" >&2
       exit 1 ;;
    *) echo "$NAME: в .env несколько строк DEPLOY_IMAGE — оставьте одну и повторите" >&2; exit 1 ;;
  esac
  [[ $IMAGE =~ ^[A-Za-z0-9][A-Za-z0-9._/:-]*$ ]] ||
    { echo "$NAME: DEPLOY_IMAGE=$IMAGE — to меняет только тег (ghcr.io/<владелец>/<образ>:<тег>), не дайджест @sha256" >&2; exit 1; }
  [[ ${IMAGE##*/} != *:* ]] || repo=${IMAGE%:*}         # тег — после последнего /: в registry:5000/x «:» — порт
  TO=$repo:$TAG
}

# to <тег>: тот же образ, что в DEPLOY_IMAGE, с другим тегом. Сначала образ: нет его в реестре (CI ещё
# собирает, опечатка в хеше) — ничего не меняется. Есть — выкладка, как у новой версии, и только после неё —
# тег в .env: сбой — работает прежняя версия, и .env прежний (таймер берёт образ из .env и до успеха
# нового не видит). Решение администратора, как откат: версия, которая уже не удалась, выкладывается снова,
# а сбой to запрет с версии, которая не удалась у таймера, не снимает (fail)
to() {
  tag_ref
  docker pull -q "$TO" >/dev/null ||
    { echo "$NAME: $TO не скачать (нет такого тега — CI ещё собирает или опечатка) — ничего не менял" >&2; exit 1; }
  NEW=$(version_of "$TO")
  [ -n "$NEW" ] || { echo "$NAME: у образа $TO нет дайджеста реестра" >&2; exit 1; }
  OLD=$(state current)
  BACK=${OLD:-$(running_image)}
  if [ "$NEW" = "$OLD" ]; then echo "$NAME: эта версия уже работает"; else roll_out; fi
  [ "$IMAGE" != "$TO" ] || return 0

  # Новый .env — во временном файле в папке проекта, затем на место одним mv. Папку проекта пишет только root
  # (роль project: root, 0750 — это и проверяем), web/ — и участники: временный файл там подменили бы ссылкой,
  # и root записал бы в цель ссылки и поставил ей владельца и права .env. Та же файловая система — mv переименовывает,
  # а ссылку на месте .env заменяет, не идя по ней. .env читается один раз, без перехода по ссылке (dd с nofollow и nonblock);
  # владелец, права и ACL (доступ контейнеров и пользователя проекта без root) — прежние, с того же файла:
  # подменили его, пока root переписывал, — отказ. Выкладка шла минуты — .env мог стать ссылкой: проверка ещё раз
  local half="работает $TO, но .env не записан — таймер вернёт образ из .env; впишите DEPLOY_IMAGE=$TO сами"
  local before uid gid mode
  [ -f .env ] && [ ! -L .env ] ||
    { echo "$NAME: .env подменили — теперь это ссылка или не файл, root его не читает; $half" >&2; exit 1; }
  before=$(stat -c '%i %u %g %a %F' -- .env) || { echo "$NAME: $half" >&2; exit 1; }
  read -r _ uid gid mode _ <<<"$before"
  ENV_NEW=$(mktemp "$PROJ/.env.XXXXXX")
  trap 'rm -f "$ENV_NEW"' EXIT
  dd if=.env iflag=nofollow,nonblock status=none | sed "s|^DEPLOY_IMAGE=.*|DEPLOY_IMAGE=$TO|" > "$ENV_NEW" &&
    chown "$uid:$gid" "$ENV_NEW" && getfacl -n -p -- .env | setfacl --set-file=- "$ENV_NEW" && chmod "$mode" "$ENV_NEW" &&
    [ "$(stat -c '%i %u %g %a %F' -- .env)" = "$before" ] && mv -fT "$ENV_NEW" .env ||
    { echo "$NAME: $half" >&2; exit 1; }
  echo "$NAME: в .env DEPLOY_IMAGE=$TO"
  infra-log "выкладка $NAME: DEPLOY_IMAGE ${IMAGE##*/} → ${TO##*/}"
}

# to <тег> --wait — сразу после push: ждать, пока CI соберёт образ, до 45 попыток docker pull раз в 20 с (~15 минут).
# Зовётся до замка: таймер проекта тем временем выкладывает как обычно, .env и состояние не тронуты, Ctrl+C — ничего
# не меняется. До первого pull от root — те же проверки, что у to: .env без перехода по ссылке, образ из репозитория
# image, отказы без реестра (tag_ref) — сразу, а не через 15 минут. Образ есть — дальше обычный to: замок, .env
# читается заново, все проверки, выкладка (его pull уже быстрый). Не дождался — отказ и последняя строка ошибки
# docker pull; в журнал событий не пишем, как и отказ to «нет тега»
wait_for_tag() {
  local try err
  cd "$WEB"
  read_image
  own_image "$IMAGE" "DEPLOY_IMAGE=$IMAGE" || exit 1
  tag_ref
  for ((try = 1; try <= 45; try++)); do
    err=$(docker pull -q "$TO" 2>&1 >/dev/null) && { echo "$NAME: образ $TO есть — выкладываю"; return 0; }
    if ((try == 1)); then
      echo "$NAME: $TO в реестре ещё нет — жду, пока CI соберёт (до 15 минут; Ctrl+C — прервать, ничего не изменится)"
    elif (( (try - 1) % 3 == 0 )); then
      echo "$NAME: $TO ещё нет — жду ($(( (try - 1) / 3 )) мин)"
    fi
    ((try == 45)) || sleep 20
  done
  echo "$NAME: за 15 минут $TO в реестре не появился — ничего не менял (CI упал? тег верный?)" >&2
  echo "docker pull: ${err##*$'\n'}" >&2
  exit 1
}

# ---------- Запуск ----------
# to --wait: образ ждём до замка (wait_for_tag)
[ "$WAIT" != --wait ] || wait_for_tag
mkdir -p /var/lib/project-deploy
exec 9>"$STATE.lock"
if [ "$ACTION" = deploy ]; then
  flock -n 9 || exit 0                                  # прошлая выкладка ещё идёт — проверим через 15 секунд
else
  # Откат и to ждут, пока таймер закончит проверку (около секунды; после удачной выкладки — ещё до 15 с
  # отправки в Telegram). Идёт выкладка — не ждём:
  # после неё «прежней» станет другая версия
  flock -w 30 9 || { echo "$NAME: идёт выкладка — ничего не менял; посмотрите журнал и повторите" >&2; exit 1; }
fi
cd "$WEB"
read_image
# Образ из .env — из репозитория image (own_image): так закрыты и deploy, и to (тот же репозиторий), и rollback
own_image "$IMAGE" "DEPLOY_IMAGE=$IMAGE" || exit 1
# compose выкладки — с проверенным образом (image: ${DEPLOY_IMAGE}) в окружении: оно у compose сильнее --env-file,
# а .env compose читает шире, чем чтение IMAGE выше (export DEPLOY_IMAGE=…, пробел в начале, DEPLOY_IMAGE: …), — иначе
# скрипт проверил бы и пометил свой образ, а up скачал бы от root чужой
export DEPLOY_IMAGE=$IMAGE

case $ACTION in
  deploy) deploy ;;
  rollback) rollback ;;
  to) to ;;
esac

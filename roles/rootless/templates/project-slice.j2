# Управляется Ansible (роль rootless). Лимиты проекта {{ item }} в Docker группы {{ rootless_group_of[item] }}:
# все его контейнеры (через cgroup_parent в base.yml) работают в этом slice systemd пользователя группы.
[Unit]
Description=Project {{ item }}

[Slice]
MemoryMax={{ (projects[item].memory | default(project_default_memory)) | upper }}
{# Без MemorySwapMax=0 на сервере со swap лимит мягкий: проект уходит в swap, OOM и уведомления нет #}
MemorySwapMax=0
CPUQuota={{ ((projects[item].cpus | default(project_default_cpus)) | float * 100) | round | int }}%

# Управляется Ansible (роль rootless). Docker без root пользователя проекта без root (<проект>-run,
# группа rootless) — как его ставит dockerd-rootless-setuptool.sh, но общий файл в /etc: в домашнюю
# папку пользователя root не пишет (её меняют участники проекта). Запускается у каждого пользователя
# группы rootless сам, без входа (linger). Лимиты памяти и CPU — на весь его user-<uid>.slice.
[Unit]
Description=Docker без root (проект)
ConditionGroup=rootless
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Environment=PATH=/usr/bin:/sbin:/usr/sbin:/usr/local/bin:/bin
ExecStart=/usr/bin/dockerd-rootless.sh --config-file=/etc/infra-rootless/daemon.json
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=notify
NotifyAccess=all
KillMode=mixed

[Install]
WantedBy=default.target

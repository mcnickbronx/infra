# Локальный репозиторий (уровень 1)
RESTIC_REPOSITORY={{ restic_local_repo }}
RESTIC_PASSWORD={{ restic_password }}
HC_URL={{ backup_healthcheck_url }}
# Кэш restic. У служб systemd нет $HOME, и без этой строки restic работает без кэша: каждый
# запуск заново читает индекс хранилища, из S3 — по сети (частые снимки — до сотен раз в сутки)
RESTIC_CACHE_DIR=/var/cache/restic

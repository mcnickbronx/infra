{#- Проекты сервера для project-backup / project-restore / backup-hourly: имя, тип базы (пользователь базы = имя
    проекта), частые снимки (db — только база, all — база и папки, null — нет) и как часто, минут -#}
{% set items = [] %}
{% for name, p in projects.items() %}

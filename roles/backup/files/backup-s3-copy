#!/usr/bin/env bash
# Управляется Ansible.
# Копия в S3 (уровень 3): дописать туда снимки локального репозитория, которых там ещё нет
# (restic copy). S3 не настроен (/etc/restic/s3-env нет) — ничего не делает.
# Запускают ночной бэкап (backup.sh) и частые снимки (backup-hourly.sh) — под своей общей
# блокировкой, по очереди.
#
# В S3 сервер ничего не удаляет. Object Lock держит файл 30 дней с записи, а restic в новых
# снимках ссылается на файлы первых — через 30 дней их можно было бы стереть ключами сервера,
# и сломались бы все снимки. Поэтому раз в 14 дней (меньше 30) копия начинается заново: новая
# папка <сервер>/<дата начала>, в неё — все снимки локального репозитория. Полная копия, которой
# не нужны старые файлы, всегда моложе 14 дней, то есть заблокирована.
# Старые папки убирает правило жизненного цикла бакета (README, «Бэкапы»).
# Параметры разбиения на блоки — как у локального репозитория, иначе дедупликация не работает.
set -Eeuo pipefail

[ -f /etc/restic/s3-env ] || exit 0
set -a; source /etc/restic/s3-env; set +a

DAYS=14
START=$(date -u -d "@$(( $(date -u +%s) / 86400 / DAYS * DAYS * 86400 ))" +%F)
export RESTIC_REPOSITORY=$RESTIC_REPOSITORY/$START
echo "=== S3: $RESTIC_REPOSITORY"
restic cat config >/dev/null 2>&1 || restic init --copy-chunker-params
restic copy

# Управляется Ansible. IP администратора (admin_ips) и участников проектов этого сервера
# (ips в people) — те же, что в белом списке SSH, — не банятся: ни за ошибки с ключом, ни за
# запросы, которые CrowdSec счёл бы сканированием сайта. IPv4 самого сервера — тоже: проект без root
# ходит к своим доменам с публичного IP сервера, и бан этого IP отрезал бы сервер от своих же сайтов
name: ansible/admin-whitelist
description: "Admin, people and server IPs from Ansible"
whitelist:
  reason: "admin_ips, people ips and server ips"
  ip:
{% for ip in (ssh_allowed_ips + server_ips) | unique | reject('search', '/') %}
    - "{{ ip }}"
{% else %}
    - "127.0.0.1"
{% endfor %}
  cidr:
{% for ip in ssh_allowed_ips | select('search', '/') %}
    - "{{ ip }}"
{% else %}
    - "127.0.0.0/8"
{% endfor %}

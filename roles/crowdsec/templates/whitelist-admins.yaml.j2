# Управляется Ansible. IP администратора (admin_ips) и участников проектов этого сервера
# (ips в people) — те же, что в белом списке SSH, — не банятся: ни за ошибки с ключом, ни за
# запросы, которые CrowdSec счёл бы сканированием сайта
name: ansible/admin-whitelist
description: "Admin and people IPs from Ansible"
whitelist:
  reason: "admin_ips and people ips"
  ip:
{% for ip in ssh_allowed_ips | reject('search', '/') %}
    - "{{ ip }}"
{% else %}
    - "127.0.0.1"
{% endfor %}
  cidr:
{% for ip in ssh_allowed_ips | select('search', '/') %}
    - "{{ ip }}"
{% else %}
    - "127.0.0.0/8"
{% endfor %}

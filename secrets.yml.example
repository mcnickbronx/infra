# Пароли и ключи сервера: /etc/infra/secrets.yml (только root). Его читает sudo infra apply.
# Здесь — образец; установщик кладёт его на новый сервер. Копия себе, не выводя пароли
# в консоль: ssh <сервер> sudo cat /etc/infra/secrets.yml > <файл>
#
# ---------- Вписываете сами: пусто — не используется ----------
# Строки — заготовки: нужное заполните, остальное оставьте пустым. Стёртую строку
# sudo infra apply вернёт пустой.
s3_access_key: ""        # копия бэкапов в S3 (restic_s3_repository_base в server.yml): ключи бакета
s3_secret_key: ""
ghcr_user: ""            # автовыкладка (autodeploy в server.yml): пользователь GitHub и токен classic
ghcr_token: ""           #   с правом read:packages — вход в ghcr.io
telegram_bot_token: ""   # уведомления: токен бота команды (@BotFather) и id чата — его подскажет
telegram_chat_id: ""     #   sudo infra-notify --find-chat; несколько чатов — через запятую
telegram_proxy: ""       # если Telegram с сервера закрыт: socks5h://логин:пароль@хост:порт или http://хост:порт
#
# ---------- Создаёт движок ----------
# sudo infra apply дописывает ниже недостающие (первый — все сразу); записанные не меняет:
#   restic_password          — пароль бэкапов; сохраните в менеджере паролей: без него их не расшифровать
#   postgres_admin_password  — администратор Postgres (вы, admin_user): все базы, через туннель
#   db_password_<проект>     — база проекта. Сменить — удалить строку и sudo infra apply,
#                              новый пароль затем перенести в .env проекта
#   access_token             — секрет ссылки доступа (пока access_link включена)
# Адрес и порт базы проекта — server.yml.example, раздел «Проекты».
